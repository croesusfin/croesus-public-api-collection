meta {
  name: Get a list of accounts based in the filters sent
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/crm/api/v2/Accounts
  body: none
  auth: inherit
}

params:query {
  ~accountIds: 
  ~accountNumbers: 
  ~clientIds: 
  ~clientNumbers: 
  ~investmentAdvisorCodes: 
  ~accountCurrency: 
  ~requestedCurrency: 
  ~shortName: 
  ~totalValueGT: 
  ~totalValueLT: 
  ~typeDescription: 
  ~profile: 
  ~after: 
  ~before: 
  ~pageLimit: 
  ~sortingRules: 
}

headers {
  apiroute: {{apiRoute}}
  apikey: {{apiKey}}
}
