meta {
  name: Get all the notes base on the filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/crm/api/v2/:contextType/:contextId/Notes
  body: none
  auth: inherit
}

params:query {
  ~noteIds: 
  ~comment: 
  ~firstName: 
  ~lastName: 
  ~dateFrom: 
  ~dateTo: 
  ~isReviewed: 
  ~after: 
  ~before: 
  ~pageLimit: 
  ~sortingRules: 
}

params:path {
  contextType: 
  contextId: 
}

headers {
  apiroute: {{apiRoute}}
  apikey: {{apiKey}}
}
