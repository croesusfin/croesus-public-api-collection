meta {
  name: Get a list of relationships based in the filters sent
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/crm/api/v2/Relationships
  body: none
  auth: inherit
}

params:query {
  ~relationshipNumbers: 
  ~investmentAdvisorCodes: 
  ~relationshipIds: 
  ~clientIds: 
  ~accountIds: 
  ~relationshipCurrency: 
  ~requestedCurrency: 
  ~relationshipTypeDescription: 
  ~shortName: 
  ~totalValueGT: 
  ~totalValueLT: 
  ~after: 
  ~before: 
  ~pageLimit: 
  ~sortingRules: 
}

headers {
  apiroute: {{apiRoute}}
  apikey: {{apiKey}}
}
