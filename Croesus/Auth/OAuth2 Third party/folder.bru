meta {
  name: OAuth2 Third party
}

auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: {{baseUrl}}/loginCallback.php
  authorization_url: {{baseUrl}}/connect/authorize
  access_token_url: {{baseUrl}}/connect/token?apikey={{apiKey}}&apiroute={{apiRoute}}
  refresh_token_url: 
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
  scope: openid profile croesusapi croesusclaims offline_access
  state: 
  pkce: false
  credentials_placement: basic_auth_header
  credentials_id: credentials
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

auth:oauth2:additional_params:auth_req:queryparams {
  apikey: {{apiKey}}
  apiroute: {{apiRoute}}
}
