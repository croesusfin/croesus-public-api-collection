meta {
  name: Get the Projected Income for each asset class of a selected portfolio for the coming 12 months following the call’s date for a given account
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pfm/api/v1/accounts/:accountId/portfolio/projectedincome/assetclasses
  body: none
  auth: inherit
}

params:query {
  ~requestedCurrency: 
  ~assetAllocationId: 
}

params:path {
  accountId: 
}

headers {
  apiroute: {{apiRoute}}
  apikey: {{apiKey}}
}
