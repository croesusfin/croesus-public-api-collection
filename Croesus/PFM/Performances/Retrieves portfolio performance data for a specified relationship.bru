meta {
  name: Retrieves portfolio performance data for a specified relationship.
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/pfm/api/v1/relationships/:relationshipId/portfolio/performances
  body: none
  auth: inherit
}

params:query {
  ~calculationMethod: 
  ~cumulativePeriods: 
  ~fixedPeriods: 
  ~requestedCurrency: 
  ~considerManagementStartDate: 
  ~includeInflowOutflowRevenue: 
  ~includeNonAnnualizedValues: 
}

params:path {
  relationshipId: 
}

headers {
  apiroute: {{apiRoute}}
  apikey: {{apiKey}}
}
