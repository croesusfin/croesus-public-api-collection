meta {
  name: Retrieves the cumulated portfolio values for a specific account as of a given date.
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pfm/api/v1/accounts/:accountId/portfolio/cumulatedvalues/asof
  body: none
  auth: inherit
}

params:query {
  ~requestedCurrency: 
  ~portfolioDate: 
}

params:path {
  accountId: 
}

headers {
  apiroute: {{apiRoute}}
  apikey: {{apiKey}}
}
