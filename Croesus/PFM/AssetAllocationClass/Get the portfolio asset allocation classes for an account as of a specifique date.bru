meta {
  name: Get the portfolio asset allocation classes for an account as of a specifique date
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/pfm/api/v1/accounts/:accountId/portfolio/assetAllocations/assetClasses/asof
  body: none
  auth: inherit
}

params:query {
  ~requestedCurrency: 
  ~includeFundAllocation: 
  ~portfolioDate: 
}

params:path {
  accountId: 
}

headers {
  apiroute: {{apiRoute}}
  apikey: {{apiKey}}
}
