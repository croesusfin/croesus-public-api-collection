meta {
  name: OAuth2 Third party
}

auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: {{Base_URL}}/connect/token?apikey={{apikey}}&apiroute={{apiroute}}
  refresh_token_url: 
  client_id: {{Client_id}}
  client_secret: {{Client_secret}}
  scope: openid profile croesusapi croesusclaims offline_access
  credentials_placement: basic_auth_header
  credentials_id: 
  token_placement: header
  token_header_prefix: 
  auto_fetch_token: true
  auto_refresh_token: false
}
