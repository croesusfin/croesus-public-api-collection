meta {
  name: Retrieves the portfolio performance data for a specific client.
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/pfm/api/v1/clients/:clientId/portfolio/performances
  body: none
  auth: inherit
}

params:query {
  ~calculationMethod: 
  ~cumulativePeriods: 
  ~fixedPeriods: 
  ~requestedCurrency: 
  ~considerManagementStartDate: 
  ~includeInflowOutflowRevenue: 
  ~includeNonAnnualizedValues: 
}

params:path {
  clientId: 
}

headers {
  apiroute: {{apiRoute}}
  apikey: {{apiKey}}
}
